      "id": "be3881c5-977f-43ac-83dc-6110499b6eeb",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response =\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  $json.content;\n\nif (!response) {\n  throw new Error('AI returned an empty response');\n}\n\nlet text = String(response).trim();\n\n// Remove markdown if the AI accidentally returns ```json\ntext = text\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\n// Find JSON object\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\n\nif (start === -1 || end === -1) {\n  throw new Error(`AI did not return valid JSON: ${text}`);\n}\n\nconst jsonText = text.substring(start, end + 1);\n\nlet cleaned;\n\ntry {\n  cleaned = JSON.parse(jsonText);\n} catch (error) {\n  throw new Error(`JSON parsing failed: ${jsonText}`);\n}\n\n// Email validation\nconst email = String(cleaned.Email || '').trim();\n\nconst emailValid =\n  email !== '' &&\n  email !== 'INVALID_EMAIL';\n\ncleaned.Email_Status = emailValid\n  ? 'VALID'\n  : 'INVALID';\n\n// City classification\nconst city = String(cleaned.City || '')\n  .trim()\n  .toLowerCase();\n\ncleaned.City_Category =\n  city === 'chennai'\n    ? 'CHENNAI'\n    : 'OTHER';\n\nreturn {\n  json: cleaned\n};"
      },
